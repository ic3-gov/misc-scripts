registerCommand(
    {"keybind"},
    "keybind (key)",
    "Changes the command bar keybind",
    function(arguments)
        local requestedKey = arguments[1]

        if not requestedKey then
            return "Usage: keybind (key)"
        end

        local newKey = findKeyCode(requestedKey)

        if not newKey or newKey == Enum.KeyCode.Unknown then
            return "Invalid key: " .. requestedKey
        end

        ToggleKey = newKey

        sendNotification(
            "Keybind Changed",
            "Command bar key changed to " .. newKey.Name .. ".",
