registerCommand(
    {"rejoin", "rj"},
    "rejoin / rj",
    "Rejoins the current server",
    function()
        local placeId = game.PlaceId
        local jobId = game.JobId

        task.defer(function()
            setOpen(false)

            sendNotification(
                "Rejoin",
