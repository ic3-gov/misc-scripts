--==========================================================
-- COMPLETE DELIVERY
--==========================================================

local function completeDelivery()

    if running
        or not alive() then

        return false
    end

    running = true

    if hasFoodBox() then

        local box =
            getFoodBox()

        setStatus(
            "Food box found, skipping pickup"
        )

        print(
            "[FoodDelivery] Existing Food box:",
            box
            and box:GetFullName()
        )

    else

        setStatus(
            "Finding pickup..."
        )

        local pickup =
            getActivePickup()

        if not pickup then

            setStatus(
                "No active pickup"
            )

            running = false

            return false
        end

        setStatus(
            "Going to pickup..."
        )

        if not moveTo(
            pickup
        ) then

            running = false

            return false
        end

        setStatus(
            "Collecting food..."
        )

        if not collectPickup(
            pickup
        ) then

            setStatus(
                "Pickup failed after 5 attempts"
            )

            running = false

            return false
        end

        setStatus(
            "Food box received"
        )
    end

    setStatus(
        "Finding delivery..."
    )

    local delivery =
        waitForDelivery(10)

    if not delivery then

        setStatus(
            "No active delivery"
        )

        running = false

        return false
    end

    setStatus(
        "Going to delivery..."
    )

    if not moveTo(
        delivery
    ) then

        running = false

        return false
    end

    if not hasFoodBox() then

        setStatus(
            "Food box missing"
        )

        running = false

        return false
    end

    setStatus(
        "Delivering..."
    )

    if not deliverFood(
        delivery
    ) then

        setStatus(
            "Delivery stopped"
        )

        running = false

        return false
    end

    setStatus(
        "Complete"
    )

    running = false

    return true
end

--==========================================================
-- COMPLETE ONE
--==========================================================

connect(completeButton.MouseButton1Click, function()
    if not running then
        task.spawn(completeDelivery)
    end
end)

--==========================================================
-- AUTO COMPLETE
--==========================================================

connect(autoButton.MouseButton1Click, function()

    autoEnabled = not autoEnabled

    if autoEnabled then

        autoButton.Text =
            "Auto Complete: ON"

        autoButton.BackgroundColor3 =
            Color3.fromRGB(
                42,
                76,
                50
            )

        task.spawn(function()

            while alive()
                and autoEnabled do

                if not running then

                    if hasFoodBox()
                        or getActivePickup() then

                        completeDelivery()

                        if alive()
                            and autoEnabled then

                            setStatus(
                                "Waiting for next job..."
                            )

                            task.wait(
                                0.75
                            )
                        end

                    else

                        setStatus(
                            "Waiting for pickup..."
                        )

                        task.wait(
                            0.25
                        )
                    end

                else

                    task.wait(
                        0.1
                    )
                end
            end
        end)

    else

        autoButton.Text =
            "Auto Complete: OFF"

        autoButton.BackgroundColor3 =
            Color3.fromRGB(
                74,
                42,
                42
            )

        running = false

        setStatus(
            "Stopped"
        )
    end
end)

