    local old = ENV.FoodDeliveryAuto

    old.Killed = true

    if old.Gui then
        pcall(function()
            old.Gui:Destroy()
        end)
    end

    if old.Connections then
        for _, connection in ipairs(old.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
    end
end

