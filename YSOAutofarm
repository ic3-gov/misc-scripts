--==========================================================
-- CHARACTER
--==========================================================

local function getCharacter()
    return player.Character
        or player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():WaitForChild(
        "HumanoidRootPart"
    )
end

--==========================================================
-- FOOD BOX
--==========================================================

local function getFoodBox()

    local character = getCharacter()

    local box =
        character:FindFirstChild(
            FOOD_BOX_NAME,
            true
        )

    if box then
        return box
    end

    local backpack =
        player:FindFirstChildOfClass(
            "Backpack"
        )

    if backpack then

        box =
            backpack:FindFirstChild(
                FOOD_BOX_NAME,
                true
            )

        if box then
            return box
        end
    end

    return nil
end

local function hasFoodBox()
    return getFoodBox() ~= nil
end

--==========================================================
-- ACTIVE POINT DETECTION
--==========================================================

local function getActivePoint(folder, pointName)

    for _, point in ipairs(
        folder:GetChildren()
    ) do

        if point:IsA("BasePart")
            and point.Name == pointName then

            local billboard =
                point:FindFirstChild(
                    "BillboardGui"
                )

            if billboard
                and billboard.Enabled then

                return point
            end
        end
    end

    return nil
end

local function getActivePickup()
    return getActivePoint(
        pickupPoints,
        "Pickup"
    )
end

local function getActiveDelivery()
    return getActivePoint(
        deliveryPoints,
        "Delivery"
    )
end

--==========================================================
-- DISTANCE
--==========================================================

local function getHorizontalDistance(
    positionA,
    positionB
)

    local difference =
        Vector3.new(
            positionA.X - positionB.X,
            0,
            positionA.Z - positionB.Z
        )

    return difference.Magnitude
end

--==========================================================
-- RAYCAST
--==========================================================

local function makeRayParams()

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        getCharacter()
    }

    params.IgnoreWater = false

    return params
end

local function getPartTop(
    part,
    hitPosition
)

    if part
        and part:IsA("BasePart") then

        return part.Position.Y
            + part.Size.Y / 2
    end

    return hitPosition.Y
end

--==========================================================
-- DIRECT TELEPORT
--==========================================================

local function teleportToJobPoint(target)

    if not target
        or not target.Parent then

        return false
    end

    local root = getRoot()

    root.CFrame =
        CFrame.new(
            target.Position.X,
            target.Position.Y + 1.5,
            target.Position.Z
        )
        * root.CFrame.Rotation

    RunService.Heartbeat:Wait()
    RunService.Heartbeat:Wait()

    task.wait(0.1)

    return true
end

--==========================================================
-- MOVEMENT
--==========================================================

local function moveTo(target)

    if not target
        or not target.Parent then

        return false
    end

    local root = getRoot()
    local rayParams = makeRayParams()

    while alive()
        and running
        and target.Parent do

        root = getRoot()

        local horizontalDistance =
            getHorizontalDistance(
                root.Position,
                target.Position
            )

        --==================================================
        -- WITHIN 30 STUDS
        -- DIRECT TELEPORT
        --==================================================

        if horizontalDistance
            <= DIRECT_TELEPORT_DISTANCE then

            return teleportToJobPoint(
                target
            )
        end

        local difference =
            target.Position
            - root.Position

        local distance =
            difference.Magnitude

        if distance <= 0.01 then

            return teleportToJobPoint(
                target
            )
        end

        local dt =
            RunService.Heartbeat:Wait()

        -- Recheck after heartbeat.

        horizontalDistance =
            getHorizontalDistance(
                root.Position,
                target.Position
            )

        if horizontalDistance
            <= DIRECT_TELEPORT_DISTANCE then

            return teleportToJobPoint(
                target
            )
        end

        difference =
            target.Position
            - root.Position

        distance =
            difference.Magnitude

        if distance <= 0.01 then

            return teleportToJobPoint(
                target
            )
        end

        local direction =
            difference.Unit

        local step =
            math.min(
                speed * dt,
                distance
            )

        --==================================================
        -- OBSTACLE DETECTION
        --==================================================

        local checkDistance =
            math.max(
                step + 4,
                LOOK_AHEAD
            )

        local obstacle =
            workspace:Raycast(
                root.Position,
                direction * checkDistance,
                rayParams
            )

        if obstacle then

            local hit =
                obstacle.Instance

            local topY =
                getPartTop(
                    hit,
                    obstacle.Position
                )

            local safeY =
                topY
                + OBSTACLE_PADDING

            if root.Position.Y < safeY then

                local climbTarget =
                    Vector3.new(
                        root.Position.X,
                        safeY,
                        root.Position.Z
                    )

                local climbDifference =
                    climbTarget
                    - root.Position

                local climbDistance =
                    climbDifference.Magnitude

                if climbDistance > 0.05 then

                    local climbStep =
                        math.min(
                            speed * dt,
                            climbDistance
                        )

                    root.CFrame =
                        CFrame.new(
                            root.Position
                            + climbDifference.Unit
                            * climbStep
                        )
                        * root.CFrame.Rotation

                    continue
                end
            end
        end

        --==================================================
        -- FORWARD MOVEMENT
        --==================================================

        local newPosition =
            root.Position
            + direction * step

        --==================================================
        -- GROUND PROTECTION
        --==================================================

        local ground =
            workspace:Raycast(

                newPosition
                + Vector3.new(
                    0,
                    6,
                    0
                ),

                Vector3.new(
                    0,
                    -20,
                    0
                ),

                rayParams
            )

        if ground then

            local minimumY =
                ground.Position.Y
                + GROUND_CLEARANCE

            if newPosition.Y
                < minimumY then

                newPosition =
                    Vector3.new(
                        newPosition.X,
                        minimumY,
                        newPosition.Z
                    )
            end
        end

        root.CFrame =
            CFrame.new(newPosition)
            * root.CFrame.Rotation
    end

    return false
end

--==========================================================
-- PICKUP
--==========================================================

local function collectPickup(initialPickup)

    local pickup =
        initialPickup

    for attempt = 1, 5 do

        if not alive()
            or not running then

            return false
        end

        if hasFoodBox() then
            return true
        end

        local activePickup =
            getActivePickup()

        if activePickup then
            pickup = activePickup
        end

        if not pickup
            or not pickup.Parent then

            warn(
                "[FoodDelivery] Pickup disappeared"
            )

            return false
        end

        local prompt =
            pickup:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

        if not prompt then

            warn(
                "[FoodDelivery] Pickup prompt missing"
            )

            return false
        end

        if not teleportToJobPoint(
            pickup
        ) then

            return false
        end

        local root =
            getRoot()

        local distance =
            (
                root.Position
                - pickup.Position
            ).Magnitude

        print(
            "[FoodDelivery]",
            "Pickup attempt:",
            attempt,
            "| Prompt:",
            prompt:GetFullName(),
            "| Action:",
            prompt.ActionText,
            "| Object:",
            prompt.ObjectText,
            "| Enabled:",
            prompt.Enabled,
            "| Distance:",
            distance,
            "| Max:",
            prompt.MaxActivationDistance
        )

        if prompt.Enabled
            and distance
            <= prompt.MaxActivationDistance then

            local success, err =
                pcall(function()

                    fireproximityprompt(
                        prompt
                    )
                end)

            if not success then

                warn(
                    "[FoodDelivery] Pickup error:",
                    err
                )
            end

        else

            warn(
                "[FoodDelivery] Pickup prompt out of range or disabled"
            )
        end

        local started =
            os.clock()

        while alive()
            and running
            and os.clock() - started
            < 1.5 do

            if hasFoodBox() then

                print(
                    "[FoodDelivery] Food box received"
                )

                return true
            end

            task.wait(0.1)
        end

        task.wait(0.25)
    end

    return hasFoodBox()
end

--==========================================================
-- WAIT FOR DELIVERY
--==========================================================

local function waitForDelivery(timeout)

    local started =
        os.clock()

    while alive()
        and running
        and os.clock() - started
        < timeout do

        local delivery =
            getActiveDelivery()

        if delivery then
            return delivery
        end

        task.wait(0.1)
    end

    return nil
end

--==========================================================
-- REPEATED DELIVERY
-- Keep firing until Food box disappears.
--==========================================================

local function deliverFood(initialDelivery)

    local delivery =
        initialDelivery

    local attempt = 0

    while alive()
        and running
        and hasFoodBox() do

        attempt = attempt + 1

        --==================================================
        -- REFRESH DELIVERY POINT
        --==================================================

        local activeDelivery =
            getActiveDelivery()

        if activeDelivery then
            delivery = activeDelivery
        end

        if not delivery
            or not delivery.Parent then

            warn(
                "[FoodDelivery] Delivery point disappeared"
            )

            task.wait(
                DELIVERY_RETRY_DELAY
            )

            continue
        end

        --==================================================
        -- FIND PROMPT
        --==================================================

        local prompt =
            delivery:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

        if not prompt then

            warn(
                "[FoodDelivery] Delivery prompt missing"
            )

            task.wait(
                DELIVERY_RETRY_DELAY
            )

            continue
        end

        --==================================================
        -- STAY AT DELIVERY POINT
        --==================================================

        teleportToJobPoint(
            delivery
        )

        -- Food may have disappeared while moving.

        if not hasFoodBox() then
            return true
        end

        local root =
            getRoot()

        local distance =
            (
                root.Position
                - delivery.Position
            ).Magnitude

        print(
            "[FoodDelivery]",
            "Delivery attempt:",
            attempt,
            "| Enabled:",
            prompt.Enabled,
            "| Distance:",
            distance,
            "| Max:",
            prompt.MaxActivationDistance
        )

        --==================================================
        -- FIRE PROMPT
        --==================================================

        if prompt.Enabled
            and distance
            <= prompt.MaxActivationDistance then

            local success, err =
                pcall(function()

                    fireproximityprompt(
                        prompt
                    )
                end)

            if not success then

                warn(
                    "[FoodDelivery] Delivery prompt error:",
                    err
                )
            end

        else

            warn(
                "[FoodDelivery] Delivery prompt unavailable"
            )
        end

        --==================================================
        -- CHECK WHETHER DELIVERY WORKED
        --==================================================

        local checkStarted =
            os.clock()

        while alive()
            and running
            and os.clock() - checkStarted
            < DELIVERY_RETRY_DELAY do

            if not hasFoodBox() then

                print(
                    "[FoodDelivery] Delivery completed on attempt",
                    attempt
                )

                return true
            end

            task.wait(0.1)
        end

        -- If the box is still there, loop around and
        -- fire the delivery prompt again.
    end

    return not hasFoodBox()
end

