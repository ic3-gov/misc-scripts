local function registerCommand(names, usage, description, callback)
    if typeof(names) == "string" then
        names = {names}
    end

    local commandData = {
        names = names,
        usage = usage,
        description = description,
        callback = callback
    }

    table.insert(CommandEntries, commandData)

    for _, name in ipairs(names) do
        Commands[name:lower()] = commandData
    end

    createCommandEntry(commandData)
end

local function filterCommandList(searchText)
    local query = tostring(searchText or "")
        :lower()
        :match("^%s*(.-)%s*$")

    -- Only search using the command portion before the first space.
    -- This keeps matching stable while typing command arguments.
    query = query:match("^(%S*)") or ""

    local visibleCount = 0

    for _, entryData in ipairs(CommandEntryFrames) do
        local isVisible =
            query == ""
            or entryData.searchText:find(query, 1, true) ~= nil

        entryData.frame.Visible = isVisible

        if isVisible then
            visibleCount += 1
        end
    end

    if query == "" then
        ListTitle.Text = "COMMANDS"
    else
        ListTitle.Text = string.format(
            "COMMANDS  •  %d RESULT%s",
            visibleCount,
            visibleCount == 1 and "" or "S"
        )
    end

    ScrollingFrame.CanvasPosition = Vector2.zero
end

local function setOpen(state)
    CommandBarOpen = state

    if state then
        Container.Visible = true
    end

    local tween = TweenService:Create(
        Container,
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        {
            Position = state and OPEN_POSITION or CLOSED_POSITION
        }
    )

    if not state then
        tween.Completed:Once(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed and not CommandBarOpen then
                Container.Visible = false
            end
        end)
    end

    tween:Play()

    if state then
        if FreecamEnabled then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end

        task.delay(0.08, function()
            if CommandBarOpen then
                Box:CaptureFocus()
            end
        end)
    else
        Box:ReleaseFocus()
        Box.Text = ""
        filterCommandList("")

        if FreecamEnabled then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        end
    end
end

