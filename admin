local function executeCommand(text)
    local arguments = {}

    for word in text:gmatch("%S+") do
        table.insert(arguments, word)
    end

    if #arguments == 0 then
        return
    end

    local commandName = table.remove(arguments, 1):lower()
    local commandData = Commands[commandName]

    if not commandData then
        showMessage("Unknown command: " .. commandName)

        sendNotification(
            "Unknown Command",
            commandName .. " is not a valid command.",
            4
        )

        return
    end

    local success, result = pcall(function()
        return commandData.callback(arguments)
    end)

    if not success then
        showMessage("Command failed")

        sendNotification(
            "Command Failed",
            "An error occurred while running " .. commandName .. ".",
            5
        )

        return
    end

    if typeof(result) == "string" and result ~= "" then
        showMessage(result)
    else
        Box.Text = ""
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        MovementKeys[input.KeyCode] = true
    end

    if input.KeyCode ~= ToggleKey then
        return
    end

    if gameProcessed and not Box:IsFocused() then
        return
    end

    setOpen(not CommandBarOpen)
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        MovementKeys[input.KeyCode] = nil
    end
end)

Box.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = Box.Text
        Box.Text = ""
        executeCommand(text)
    end
end)

ScreenGui.Destroying:Connect(function()
    if FreecamEnabled then
        disableFreecam()
    end

    setNoclip(false)
    stopFly()
    stopSpin()

    if InvisibleEnabled then
        setInvisible(false)
    end

    if HeadlessEnabled then
        setHeadless(false)
    end

    pcall(function()
        RunService:UnbindFromRenderStep(
            "ClientAdminFreecam"
        )
    end)

    pcall(function()
        RunService:UnbindFromRenderStep(
            "ClientAdminFly"
        )
    end)
end)
