local function findKeyCode(keyName)
    local formattedName = keyName
        :lower()
        :gsub("%s+", "")
        :gsub("_", "")

    local aliases = {
        semicolon = "Semicolon",
        insert = "Insert",
        delete = "Delete",
        home = "Home",
        endkey = "End",
        pageup = "PageUp",
        pagedown = "PageDown",
        rightshift = "RightShift",
        leftshift = "LeftShift",
        rightcontrol = "RightControl",
        leftcontrol = "LeftControl",
        rightalt = "RightAlt",
        leftalt = "LeftAlt",
        backslash = "BackSlash",
        leftbracket = "LeftBracket",
        rightbracket = "RightBracket",
        quote = "Quote",
        comma = "Comma",
        period = "Period",
        slash = "Slash"
    }

    local aliasName = aliases[formattedName]

    for _, keyCode in ipairs(Enum.KeyCode:GetEnumItems()) do
        if keyCode.Name:lower() == formattedName then
            return keyCode
        end

        if aliasName and keyCode.Name == aliasName then
            return keyCode
        end
    end

    return nil
end

-- Freecam

local function enableFreecam()
    if FreecamEnabled then
        return false
    end

    Camera = workspace.CurrentCamera

    SavedCameraType = Camera.CameraType
    SavedCameraSubject = Camera.CameraSubject
    SavedCameraCFrame = Camera.CFrame
    SavedCameraFieldOfView = Camera.FieldOfView
    SavedMouseBehavior = UserInputService.MouseBehavior
    SavedMouseIconEnabled = UserInputService.MouseIconEnabled

    FreecamPosition = Camera.CFrame.Position

    local pitch, yaw = Camera.CFrame:ToOrientation()
    FreecamPitch = pitch
    FreecamYaw = yaw

    table.clear(MovementKeys)

    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CameraSubject = nil

    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false

    FreecamEnabled = true

    return true
end

local function disableFreecam()
    if not FreecamEnabled then
        return false
    end

    FreecamEnabled = false
    table.clear(MovementKeys)

    Camera = workspace.CurrentCamera
    Camera.CameraType = SavedCameraType or Enum.CameraType.Custom
    Camera.CameraSubject = SavedCameraSubject
    Camera.CFrame = SavedCameraCFrame or Camera.CFrame
    Camera.FieldOfView = SavedCameraFieldOfView or 70

    UserInputService.MouseBehavior =
        SavedMouseBehavior or Enum.MouseBehavior.Default

    if SavedMouseIconEnabled == nil then
        UserInputService.MouseIconEnabled = true
    else
        UserInputService.MouseIconEnabled = SavedMouseIconEnabled
    end

    return true
end

local function toggleFreecam()
    if FreecamEnabled then
        disableFreecam()
        return false
    else
        enableFreecam()
        return true
    end
end

local function copyToClipboard(text)
    local clipboardFunction =
        setclipboard
        or toclipboard
        or (Clipboard and Clipboard.set)

    if not clipboardFunction then
        return false
    end

    return pcall(function()
        clipboardFunction(text)
    end)
end

-- Server hopping

local function makeRequest(options)
    local requestFunction =
        request
        or http_request
        or (syn and syn.request)
        or (http and http.request)
        or (fluxus and fluxus.request)

    if requestFunction then
        return requestFunction(options)
    end

    if game.HttpGet then
        return {
            Success = true,
            StatusCode = 200,
            Body = game:HttpGet(options.Url)
        }
    end

    return nil
end

local function findDifferentServer()
    local cursor = nil
    local checkedPages = 0
    local maximumPages = 10

    repeat
        checkedPages += 1

        local cursorText = ""

        if cursor then
            cursorText =
                "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
            game.PlaceId,
            cursorText
        )

        local response = makeRequest({
            Url = url,
            Method = "GET"
        })

        if not response then
            return nil, "HTTP requests are unavailable."
        end

        if response.Success == false then
            return nil, "The server request failed."
        end

        if response.StatusCode and response.StatusCode ~= 200 then
            return nil, "The server request failed."
        end

        local success, serverData = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not success or typeof(serverData) ~= "table" then
            return nil, "Could not read the server list."
        end

        local availableServers = {}

        for _, server in ipairs(serverData.data or {}) do
            local isDifferentServer = server.id ~= game.JobId
            local hasSpace = server.playing < server.maxPlayers

            if isDifferentServer and hasSpace then
                table.insert(availableServers, server.id)
            end
        end

        if #availableServers > 0 then
            return availableServers[
                math.random(1, #availableServers)
            ]
        end

        cursor = serverData.nextPageCursor
    until not cursor or checkedPages >= maximumPages

    return nil, "No other public servers were found."
end

RunService:BindToRenderStep(
    "ClientAdminFreecam",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if not FreecamEnabled then
            return
        end

        Camera = workspace.CurrentCamera
        Camera.CameraType = Enum.CameraType.Scriptable

        if not CommandBarOpen then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false

            local mouseDelta = UserInputService:GetMouseDelta()

            FreecamYaw -= mouseDelta.X * FreecamSensitivity
            FreecamPitch -= mouseDelta.Y * FreecamSensitivity

            FreecamPitch = math.clamp(
                FreecamPitch,
                math.rad(-89),
                math.rad(89)
            )
        end

        local rotation =
            CFrame.Angles(0, FreecamYaw, 0)
            * CFrame.Angles(FreecamPitch, 0, 0)

        local direction = Vector3.zero

        if not CommandBarOpen then
            if MovementKeys[Enum.KeyCode.W] then
                direction += Vector3.new(0, 0, -1)
            end

            if MovementKeys[Enum.KeyCode.S] then
                direction += Vector3.new(0, 0, 1)
            end

            if MovementKeys[Enum.KeyCode.A] then
                direction += Vector3.new(-1, 0, 0)
            end

            if MovementKeys[Enum.KeyCode.D] then
                direction += Vector3.new(1, 0, 0)
            end

            if MovementKeys[Enum.KeyCode.E] then
                direction += Vector3.new(0, 1, 0)
            end

            if MovementKeys[Enum.KeyCode.Q] then
                direction += Vector3.new(0, -1, 0)
            end
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit

            local currentSpeed = FreecamSpeed

            if MovementKeys[Enum.KeyCode.LeftShift]
                or MovementKeys[Enum.KeyCode.RightShift] then
                currentSpeed = FreecamFastSpeed
            end

            local movement =
                rotation.RightVector * direction.X
                + Vector3.yAxis * direction.Y
                - rotation.LookVector * direction.Z

            FreecamPosition += movement * currentSpeed * deltaTime
        end

        Camera.CFrame = CFrame.new(FreecamPosition) * rotation
    end
)


-- Basic admin state / helpers

local NoclipEnabled = false
local NoclipOriginalStates = {}
local FlyEnabled = false
local FlySpeed = 70
local FlyBodyVelocity = nil
local FlyBodyGyro = nil
local SpinEnabled = false
local SpinSpeed = 8
local SpinConnection = nil
local HeadlessEnabled = false
local InvisibleEnabled = false

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local character = getCharacter()
    return character:FindFirstChildWhichIsA("Humanoid")
end

local function getRootPart()
    local character = getCharacter()
    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
end

local function findPlayerByText(text)
    text = tostring(text or ""):lower()

    if text == "" then
        return LocalPlayer
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local name = player.Name:lower()
        local displayName = player.DisplayName:lower()

        if name:sub(1, #text) == text
        or displayName:sub(1, #text) == text then
            return player
        end
    end

    return nil
end

local function setNoclip(state)
    NoclipEnabled = state

    if not state then
        for part, originalCanCollide in pairs(NoclipOriginalStates) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = originalCanCollide
                end)
            end
        end

        table.clear(NoclipOriginalStates)
    end
end

RunService.Stepped:Connect(function()
    if not NoclipEnabled then
        return
    end

    local character = LocalPlayer.Character
    if not character then
        return
    end

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            if NoclipOriginalStates[descendant] == nil then
                NoclipOriginalStates[descendant] = descendant.CanCollide
            end

            descendant.CanCollide = false
        end
    end
end)

local function stopFly()
    FlyEnabled = false

    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end

    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end

    local humanoid = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")

    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function startFly()
    local root = getRootPart()
    local humanoid = getHumanoid()

    if not root or not humanoid then
        return false
    end

    stopFly()

    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyVelocity.Name = "ClientAdminFlyVelocity"
    FlyBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyVelocity.Velocity = Vector3.zero
    FlyBodyVelocity.Parent = root

    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.Name = "ClientAdminFlyGyro"
    FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyBodyGyro.P = 9e4
    FlyBodyGyro.CFrame = root.CFrame
    FlyBodyGyro.Parent = root

    humanoid.PlatformStand = true
    FlyEnabled = true
    return true
end

RunService:BindToRenderStep(
    "ClientAdminFly",
    Enum.RenderPriority.Character.Value + 1,
    function()
        if not FlyEnabled then
            return
        end

        local root = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if not root or not FlyBodyVelocity or not FlyBodyGyro then
            stopFly()
            return
        end

        Camera = workspace.CurrentCamera

        local direction = Vector3.zero

        if MovementKeys[Enum.KeyCode.W] then
            direction += Camera.CFrame.LookVector
        end

        if MovementKeys[Enum.KeyCode.S] then
            direction -= Camera.CFrame.LookVector
        end

        if MovementKeys[Enum.KeyCode.A] then
            direction -= Camera.CFrame.RightVector
        end

        if MovementKeys[Enum.KeyCode.D] then
            direction += Camera.CFrame.RightVector
        end

        if MovementKeys[Enum.KeyCode.E]
        or MovementKeys[Enum.KeyCode.Space] then
            direction += Vector3.yAxis
        end

        if MovementKeys[Enum.KeyCode.Q]
        or MovementKeys[Enum.KeyCode.LeftControl]
        or MovementKeys[Enum.KeyCode.RightControl] then
            direction -= Vector3.yAxis
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        FlyBodyVelocity.Velocity = direction * FlySpeed
        FlyBodyGyro.CFrame = CFrame.lookAt(
            root.Position,
            root.Position + Camera.CFrame.LookVector
        )
    end
)

local function stopSpin()
    SpinEnabled = false

    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end
end

local function startSpin(speed)
    stopSpin()
    SpinSpeed = speed or SpinSpeed
    SpinEnabled = true

    SpinConnection = RunService.Heartbeat:Connect(function(deltaTime)
        local root = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if root then
            root.CFrame *= CFrame.Angles(0, SpinSpeed * deltaTime, 0)
        end
    end)
end

local function setInvisible(state)
    InvisibleEnabled = state

    local character = LocalPlayer.Character
    if not character then
        return
    end

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local keepHidden = HeadlessEnabled and descendant.Name == "Head"
            descendant.LocalTransparencyModifier =
                (state or keepHidden) and 1 or 0
        elseif descendant:IsA("Decal") then
            local keepHidden = HeadlessEnabled
                and descendant.Parent
                and descendant.Parent.Name == "Head"

            descendant.Transparency = (state or keepHidden) and 1 or 0
        end
    end
end

local function setHeadless(state)
    HeadlessEnabled = state

    local character = LocalPlayer.Character
    local head = character and character:FindFirstChild("Head")

    if not head then
        return false
    end

    head.LocalTransparencyModifier =
        (state or InvisibleEnabled) and 1 or 0

    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("Decal") then
            child.Transparency =
                (state or InvisibleEnabled) and 1 or 0
        end
    end

    return true
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.25)

    if NoclipEnabled then
        table.clear(NoclipOriginalStates)
    end

    if InvisibleEnabled then
        setInvisible(true)
    end

    if HeadlessEnabled then
        setHeadless(true)
    end

    if FlyEnabled then
        task.defer(startFly)
    end
end)

