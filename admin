local function registerCommand(names, usage, description, callback)
    if typeof(names) == "string" then
        names = {names}
    end

    local commandData = {
        names = names,
        usage = usage,
        description = description,
        callback = callback
    }

    table.insert(CommandEntries, commandData)

    for _, name in ipairs(names) do
        Commands[name:lower()] = commandData
    end

    createCommandEntry(commandData)
end

local function filterCommandList(searchText)
    local query = tostring(searchText or "")
        :lower()
        :match("^%s*(.-)%s*$")

    -- Only search using the command portion before the first space.
    -- This keeps matching stable while typing command arguments.
    query = query:match("^(%S*)") or ""

    local visibleCount = 0

    for _, entryData in ipairs(CommandEntryFrames) do
        local isVisible =
            query == ""
            or entryData.searchText:find(query, 1, true) ~= nil

        entryData.frame.Visible = isVisible

        if isVisible then
            visibleCount += 1
        end
    end

    if query == "" then
        ListTitle.Text = "COMMANDS"
    else
        ListTitle.Text = string.format(
            "COMMANDS  •  %d RESULT%s",
            visibleCount,
            visibleCount == 1 and "" or "S"
        )
    end

    ScrollingFrame.CanvasPosition = Vector2.zero
end

