local function captureCommandKey(key)
    if key == Enum.KeyCode.Escape then
        capturingKey = false
        keybindStatus.Text = "Binding canceled."
        return
    end
    if key == ToggleKey or key == Enum.KeyCode.Unknown then
        keybindStatus.Text = "Choose another key. Esc cancels."
        return
    end

    local existing = CommandBindings[key]
    if existing and existing.command ~= selectedCommand then
        keybindStatus.Text = key.Name .. " is bound to " .. existing.command.names[1] .. ". Choose another key."
        return
    end

    if selectedCommand.boundKey then
        CommandBindings[selectedCommand.boundKey] = nil
    end

    local arguments = keybindArguments.Text:match("^%s*(.-)%s*$")
    CommandBindings[key] = { command = selectedCommand, arguments = arguments }
    selectedCommand.boundKey = key
    capturingKey = false
    keybindStatus.Text = selectedCommand.names[1] .. " bound to " .. key.Name .. "."
    refreshKeybindRows()
    refreshCurrentBinds()
end

local function executeCommand(text, fromKeybind)
    local arguments = {}

    for word in text:gmatch("%S+") do
        table.insert(arguments, word)
    end

    if #arguments == 0 then
        return
    end

    local commandName = table.remove(arguments, 1):lower()
    local commandData = Commands[commandName]

    if not commandData then
        showMessage("Unknown command: " .. commandName)

        sendNotification(
            "Unknown Command",
            commandName .. " is not a valid command.",
            4
        )

        return
    end

    local success, result = pcall(function()
        return commandData.callback(arguments)
    end)

    if not success then
        showMessage("Command failed")

        sendNotification(
            "Command Failed",
            "An error occurred while running " .. commandName .. ".",
            5
        )

        return
    end

    if typeof(result) == "string" and result ~= "" then
        if fromKeybind then
            sendNotification(commandName, result, 3)
        else
            showMessage(result)
        end
    else
        Box.Text = ""
    end
end

local commandInput = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    local key = input.KeyCode
    local focusedBox = UserInputService:GetFocusedTextBox()
    if capturingKey and not focusedBox then
        captureCommandKey(key)
        return
    end

    local alreadyDown = MovementKeys[key]
    MovementKeys[key] = true

    if key == ToggleKey then
        if (not focusedBox and not gameProcessed) or Box:IsFocused() then
            setOpen(not CommandBarOpen)
        end
        return
    end

    local binding = CommandBindings[key]
    if binding and not alreadyDown and not focusedBox and not gameProcessed and not CommandBarOpen then
        executeCommand(binding.command.names[1] .. " " .. binding.arguments, true)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        MovementKeys[input.KeyCode] = nil
    end
end)

Box.FocusLost:Connect(function(enterPressed)
    if not enterPressed or not CommandBarOpen then
        return
    end

    local text = Box.Text
    setOpen(false)
    executeCommand(text)
end)

