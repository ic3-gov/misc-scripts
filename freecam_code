--------------------------------------------------------------------------------
function takeScreenshot()
	if capturing or not state.active then
		return
	end
	if not CaptureService then
		toast("Screenshots aren't available here - use your system's screenshot key", true)
		return
	end

	capturing = true
	local wasHidden = state.uiHidden
	if not wasHidden then
		setUIHidden(true, true)
	end
	hideToast(true)

	task.spawn(function()
		local finished = false
		local function restore()
			if finished then
				return
			end
			finished = true
			capturing = false
			if not wasHidden and state.active then
				setUIHidden(false, true)
			end
		end

		task.delay(5, restore) -- safety net
		task.wait(0.2) -- let the UI disappear for a couple of frames

		local ok = pcall(function()
			CaptureService:CaptureScreenshot(function(contentId)
				restore()
				local promptOk = pcall(function()
					CaptureService:PromptSaveCapturesToGallery({ contentId }, function(results)
						toast(results[contentId] and "Saved to your gallery" or "Screenshot not saved")
					end)
				end)
				if not promptOk then
					toast("Screenshot captured")
				end
			end)
		end)
		if not ok then
			restore()
			toast("Screenshot failed - try your system's screenshot key", true)
		end
	end)
end

