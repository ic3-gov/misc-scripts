local function makeSlider(opts)
	local row = new("Frame", {
		Name = opts.label,
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = body,
	})
	local nameLabel = new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = opts.label,
		Font = THEME.Font,
		TextSize = 13,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local valueButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 0, 18),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Font = THEME.Font,
		TextSize = 12,
		TextColor3 = THEME.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	local hit = new("Frame", {
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Active = true,
		Parent = row,
	})
	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = THEME.Surface,
		BorderSizePixel = 0,
		Parent = hit,
	}, { corner(2) })
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(2) })
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { corner(7) })

	local min, max = opts.min, opts.max
	local value = opts.default
	local enabled = true

	local function toAlpha(v)
		if opts.log then
			return math.log(v / min) / math.log(max / min)
		end
		return (v - min) / (max - min)
	end
	local function fromAlpha(a)
		if opts.log then
			return min * (max / min) ^ a
		end
		return min + (max - min) * a
	end
	local function render()
		local a = math.clamp(toAlpha(value), 0, 1)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		valueButton.Text = opts.format(value)
	end

	local slider = {}
	function slider:Set(v)
		value = math.clamp(v, min, max)
		render()
	end
	function slider:Get()
		return value
	end
	function slider:SetEnabled(e)
		enabled = e
		nameLabel.TextTransparency = e and 0 or 0.55
		valueButton.TextTransparency = e and 0 or 0.55
		fill.BackgroundColor3 = e and THEME.Accent or THEME.Subtext
		knob.BackgroundTransparency = e and 0 or 0.5
	end

	local function userSet(v)
		value = math.clamp(v, min, max)
		render()
		opts.onChange(value)
	end

	local dragging, dragInput = false, nil
	local function fromPointer(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		userSet(fromAlpha(a))
	end

	hit.InputBegan:Connect(function(input)
		if enabled and isPointerBegin(input) then
			dragging = true
			dragInput = input
			body.ScrollingEnabled = false
			tween(knob, 0.1, { Size = UDim2.fromOffset(18, 18) })
			fromPointer(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput)
			)
		then
			fromPointer(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput) then
			dragging = false
			dragInput = nil
			body.ScrollingEnabled = true
			tween(knob, 0.1, { Size = UDim2.fromOffset(14, 14) })
		end
	end)

	-- click the value to reset to default
	valueButton.Activated:Connect(function()
		if enabled then
			userSet(opts.default)
		end
	end)

	slider:Set(opts.default)
	return slider
end

