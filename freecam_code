--------------------------------------------------------------------------------
-- LOOK / INPUT HELPERS
--------------------------------------------------------------------------------
local function applyLook(dx, dy, radPerUnit)
	local scale = radPerUnit * state.sensitivity
	if state.zoomAwareSens then
		scale *= math.clamp(state.fovCur / 70, 0.03, 2)
	end
	state.yaw -= dx * scale
	state.pitch = math.clamp(state.pitch - dy * scale, -MAX_PITCH, MAX_PITCH)
end

local function down(key)
	return UserInputService:IsKeyDown(key)
end

local function deadzone(pos)
	local v = Vector2.new(pos.X, pos.Y)
	local m = v.Magnitude
	if m < CONFIG.StickDeadzone then
		return Vector2.zero
	end
	return v.Unit * math.min((m - CONFIG.StickDeadzone) / (1 - CONFIG.StickDeadzone), 1)
end

--------------------------------------------------------------------------------
-- RENDER STEP
--------------------------------------------------------------------------------
local function onStep(dt)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	camera = cam
	dt = math.min(dt, 1 / 15)
	camera.CameraType = Enum.CameraType.Scriptable

	typing = UserInputService:GetFocusedTextBox() ~= nil

	local mx, my, mz = 0, 0, 0 -- right, up, forward
	local zoomDir, rollDir, speedDir = 0, 0, 0
	local boost = 1

	if not typing then
		if down(KEYS.Forward) then mz += 1 end
		if down(KEYS.Backward) then mz -= 1 end
		if down(KEYS.Right) then mx += 1 end
		if down(KEYS.Left) then mx -= 1 end
		if down(KEYS.Up) or down(KEYS.UpAlt) then my += 1 end
		if down(KEYS.Down) then my -= 1 end

		if down(KEYS.RollLeft) then rollDir += 1 end
		if down(KEYS.RollRight) then rollDir -= 1 end
		if down(KEYS.ZoomIn) then zoomDir += 1 end
		if down(KEYS.ZoomOut) then zoomDir -= 1 end
		if down(KEYS.SpeedUp) then speedDir += 1 end
		if down(KEYS.SpeedDown) then speedDir -= 1 end

		if down(KEYS.Slow) then
			boost = CONFIG.SlowMultiplier
		elseif down(KEYS.Fast) or down(KEYS.FastAlt) then
			boost = CONFIG.FastMultiplier
		end
	end

	-- gamepad
	if UserInputService.GamepadEnabled then
		local okState, objs = pcall(UserInputService.GetGamepadState, UserInputService, Enum.UserInputType.Gamepad1)
		if okState and objs then
			local lookScale = state.sensitivity
			if state.zoomAwareSens then
				lookScale *= math.clamp(state.fovCur / 70, 0.03, 2)
			end
			for _, obj in ipairs(objs) do
				local kc = obj.KeyCode
				if kc == Enum.KeyCode.Thumbstick1 then
					local v = deadzone(obj.Position)
					mx += v.X
					mz += v.Y
				elseif kc == Enum.KeyCode.Thumbstick2 then
					local v = deadzone(obj.Position)
					state.yaw -= v.X * CONFIG.StickLookSpeed * lookScale * dt
					state.pitch = math.clamp(state.pitch + v.Y * CONFIG.StickLookSpeed * lookScale * dt, -MAX_PITCH, MAX_PITCH)
				elseif kc == Enum.KeyCode.ButtonR2 then
					my += obj.Position.Z
				elseif kc == Enum.KeyCode.ButtonL2 then
					my -= obj.Position.Z
				end
			end
		end
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.DPadUp) then
			zoomDir += 1
		end
		if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.DPadDown) then
			zoomDir -= 1
		end
	end

	-- touch
	if isTouch then
		mx += joyVec.X
		mz -= joyVec.Y
		if mobileUp then my += 1 end
		if mobileDown then my -= 1 end
	end

	-- continuous adjustments
	if speedDir ~= 0 then
		setSpeed(state.speed * math.exp(speedDir * 1.1 * dt), false)
	end
	if zoomDir ~= 0 then
		setFov(state.fovTarget * math.exp(-zoomDir * 0.9 * dt), false)
	end
	if rollDir ~= 0 then
		state.roll = math.clamp(state.roll + rollDir * math.rad(40) * dt, -MAX_ROLL, MAX_ROLL)
		sliders.roll:Set(math.deg(state.roll))
	end

	-- mouse look
	if state.looking then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		UserInputService.MouseIconEnabled = false
		local d = UserInputService:GetMouseDelta()
		applyLook(d.X, d.Y, CONFIG.MouseRadPerPixel)
	else
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
	end

	-- smoothing
	local rate = 2 + 48 * (1 - state.smoothness) ^ 2
	local a = 1 - math.exp(-rate * dt)

	state.curYaw += (state.yaw - state.curYaw) * a
	state.curPitch += (state.pitch - state.curPitch) * a
	state.curRoll += (state.roll - state.curRoll) * a

	-- movement (relative to the current view direction)
	local lookCF = CFrame.fromEulerAnglesYXZ(state.curPitch, state.curYaw, 0)
	local dir = lookCF.RightVector * mx + lookCF.LookVector * mz + Vector3.yAxis * my
	if dir.Magnitude > 1 then
		dir = dir.Unit
	end
	state.velocity = state.velocity:Lerp(dir * state.speed * boost, a)
	state.curPos += state.velocity * dt

	-- zoom smoothing
	state.fovCur += (state.fovTarget - state.fovCur) * (1 - math.exp(-14 * dt))

	local cf = CFrame.new(state.curPos) * CFrame.fromEulerAnglesYXZ(state.curPitch, state.curYaw, state.curRoll)
	camera.CFrame = cf
	camera.Focus = cf * CFrame.new(0, 0, -20)
	camera.FieldOfView = state.fovCur

	-- keep the character hidden (the default camera scripts also touch this)
	if state.hideCharacter then
		setCharacterTransparency(1)
	end

	-- depth of field
	if dof and state.dofEnabled then
		local focus = state.focusDistance
		if state.autoFocus then
			local result = workspace:Raycast(cf.Position, cf.LookVector * 1500, rayParams)
			local dist = result and result.Distance or 1500
			state.focusCur += (dist - state.focusCur) * (1 - math.exp(-7 * dt))
			focus = state.focusCur
			if math.abs(sliders.focus:Get() - focus) > 0.5 then
				sliders.focus:Set(focus)
			end
		end
		dof.FocusDistance = focus
		dof.InFocusRadius = math.max(1.5, focus * 0.06)
		dof.FarIntensity = state.blur
		dof.NearIntensity = state.blur * 0.4
	end
end

--------------------------------------------------------------------------------
-- HOTKEYS WHILE ACTIVE  (ContextActionService so keys are sunk from the game)
--------------------------------------------------------------------------------
local function handleHotkey(k)
	if k == KEYS.Toggle then
		disable()
	elseif k == KEYS.HideUI then
		setUIHidden(not state.uiHidden)
	elseif k == KEYS.Grid then
		setGridMode(state.gridIndex % #GRID_MODES + 1, false)
	elseif k == KEYS.DepthOfField then
		setDofEnabled(not state.dofEnabled)
	elseif k == KEYS.Screenshot then
		takeScreenshot()
	elseif k == KEYS.ResetLens then
		resetLens()
	end
end

local function onKeyAction(_, inputState, input)
	if inputState == Enum.UserInputState.Begin then
		handleHotkey(input.KeyCode)
	end
	return Enum.ContextActionResult.Sink
end

local function collectSinkInputs()
	local list, seen = {}, {}
	for _, key in pairs(KEYS) do
		if not seen[key] then
			seen[key] = true
			table.insert(list, key)
		end
	end
	table.insert(list, Enum.KeyCode.Thumbstick1)
	table.insert(list, Enum.KeyCode.Thumbstick2)
	return list
end

--------------------------------------------------------------------------------
-- ENABLE / DISABLE
--------------------------------------------------------------------------------
function enable()
	if state.active then
		return
	end
	camera = workspace.CurrentCamera
	if not camera then
		return
	end
	state.active = true

	saved.cameraType = camera.CameraType
	saved.cframe = camera.CFrame
	saved.fov = camera.FieldOfView
	saved.subject = camera.CameraSubject
	saved.mouseBehavior = UserInputService.MouseBehavior
	saved.mouseIcon = UserInputService.MouseIconEnabled

	local pitch, yaw = camera.CFrame:ToEulerAnglesYXZ()
	state.pitch, state.yaw, state.roll = pitch, yaw, 0
	state.curPitch, state.curYaw, state.curRoll = pitch, yaw, 0
	state.curPos = camera.CFrame.Position
	state.velocity = Vector3.zero
	state.baseFov = camera.FieldOfView
	state.fovTarget = camera.FieldOfView
	state.fovCur = camera.FieldOfView
	state.looking = false

	sliders.fov:Set(state.fovTarget)
	sliders.roll:Set(0)
	sliders.speed:Set(state.speed)

	camera.CameraType = Enum.CameraType.Scriptable
	setPlayerControlsEnabled(false)
	ContextActionService:BindActionAtPriority(
		ACTION_NAME,
		onKeyAction,
		false,
		Enum.ContextActionPriority.High.Value,
		table.unpack(collectSinkInputs())
	)
	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, onStep)

	if state.dofEnabled then
		dof = Instance.new("DepthOfFieldEffect")
		dof.Name = "FreecamDepthOfField"
		dof.Parent = Lighting
	end

	refreshVisibility()
	refreshPanelSize()

	local exitHint = hasKeyboard and ("  -  " .. KEYS.Toggle.Name .. " to exit") or ""
	toast("Freecam on" .. exitHint)
end

function disable()
	if not state.active then
		return
	end

	-- bring every hidden UI back first
	setUIHidden(false, true)
	capturing = false

	state.active = false
	state.looking = false
	RunService:UnbindFromRenderStep(RENDER_NAME)
	ContextActionService:UnbindAction(ACTION_NAME)

	local cam = workspace.CurrentCamera
	if cam then
		if saved.cameraType and saved.cameraType.Name == "Scriptable" then
			cam.CameraType = Enum.CameraType.Scriptable
			if saved.cframe then cam.CFrame = saved.cframe end
		else
			cam.CameraType = saved.cameraType or Enum.CameraType.Custom
		end
		local subject: Instance? = saved.subject
		if not (subject and subject.Parent) then
			local char = player.Character
			subject = char and char:FindFirstChildOfClass("Humanoid")
		end
		if subject then
			cam.CameraSubject = subject
		end
		cam.FieldOfView = saved.fov or 70
	end

	UserInputService.MouseBehavior = saved.mouseBehavior or Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = saved.mouseIcon ~= false
	setPlayerControlsEnabled(true)

	if dof then
		dof:Destroy()
		dof = nil
	end
	setCharacterTransparency(0)

	-- reset touch state
	joyTouch, joyVec, pinchPrev = nil, Vector2.zero, nil
	table.clear(lookTouches)
	mobileUp, mobileDown = false, false

	refreshVisibility()
	toast("Freecam off")
end

--------------------------------------------------------------------------------
-- INPUT
--------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	local t = input.UserInputType

	if t == Enum.UserInputType.Keyboard then
		if not processed and not state.active and input.KeyCode == KEYS.Toggle then
			enable()
		end
	elseif t == Enum.UserInputType.MouseButton2 then
		if state.active and not processed then
			state.looking = true
		end
	elseif t == Enum.UserInputType.Touch then
		if not state.active or processed then
			return
		end
		if not joyTouch and input.Position.X < gui.AbsoluteSize.X * 0.4 then
			joyTouch = input
			joyOrigin = Vector2.new(input.Position.X, input.Position.Y)
			joyVec = Vector2.zero
			if not state.uiHidden then
				joyBase.Position = UDim2.fromOffset(joyOrigin.X, joyOrigin.Y)
				joyKnob.Position = joyBase.Position
				joyBase.Visible = true
				joyKnob.Visible = true
			end
		else
			lookTouches[input] = true
			pinchPrev = nil
		end
	elseif t == Enum.UserInputType.Gamepad1 then
		local kc = input.KeyCode
		if kc == CONFIG.GamepadToggle then
			if state.active then
				disable()
			else
				enable()
			end
		elseif state.active then
			if kc == Enum.KeyCode.ButtonR1 then
				setSpeed(state.speed * 1.25, false)
			elseif kc == Enum.KeyCode.ButtonL1 then
				setSpeed(state.speed / 1.25, false)
			elseif kc == Enum.KeyCode.ButtonY then
				setUIHidden(not state.uiHidden)
			elseif kc == Enum.KeyCode.ButtonX then
				takeScreenshot()
			end
		end
	end
end)

UserInputService.InputChanged:Connect(function(input, processed)
	local t = input.UserInputType
	if not state.active then
		return
	end

	if t == Enum.UserInputType.MouseWheel then
		if not processed then
			setFov(state.fovTarget * CONFIG.ZoomPerScroll ^ input.Position.Z, false)
		end
	elseif t == Enum.UserInputType.Touch then
		if input == joyTouch then
			local R = CONFIG.JoystickRadius
			local delta = Vector2.new(input.Position.X, input.Position.Y) - joyOrigin
			local clamped = delta.Magnitude > R and delta.Unit * R or delta
			joyVec = clamped / R
			joyKnob.Position = UDim2.fromOffset(joyOrigin.X + clamped.X, joyOrigin.Y + clamped.Y)
		elseif lookTouches[input] then
			local list, count = {}, 0
			for touch in pairs(lookTouches) do
				count += 1
				list[count] = touch
			end
			if count == 1 then
				applyLook(input.Delta.X, input.Delta.Y, CONFIG.TouchRadPerPixel)
			elseif count >= 2 then
				local p1 = Vector2.new(list[1].Position.X, list[1].Position.Y)
				local p2 = Vector2.new(list[2].Position.X, list[2].Position.Y)
				local dist = (p1 - p2).Magnitude
				if pinchPrev and dist > 1 then
					setFov(state.fovTarget * (pinchPrev / dist), false)
				end
				pinchPrev = dist
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton2 then
		state.looking = false
	elseif t == Enum.UserInputType.Touch then
		if input == joyTouch then
			joyTouch = nil
			joyVec = Vector2.zero
			hideJoystickVisuals()
		end
		if lookTouches[input] then
			lookTouches[input] = nil
			pinchPrev = nil
		end
	end
end)

UserInputService.WindowFocusReleased:Connect(function()
	state.looking = false
	mobileUp, mobileDown = false, false
end)

launcher.Activated:Connect(enable)

-- Expose a cleanup hook for executor re-execution.
env.FreecamPhotoModeCleanup = function()
    if state.active then disable() end
    pcall(function() RunService:UnbindFromRenderStep(RENDER_NAME) end)
    pcall(function() ContextActionService:UnbindAction(ACTION_NAME) end)
    if gui then gui:Destroy() end
    if overlay then overlay:Destroy() end
end

