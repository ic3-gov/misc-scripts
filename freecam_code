-- HIDE UI  (our UI + the game's GUIs + Roblox CoreGui)
--------------------------------------------------------------------------------
local hiddenGuis = {}
local hiddenCore = {}
local hiddenTopbar = false
local gameGuiConn

local function hideGameUI()
	for _, child in ipairs(playerGui:GetChildren()) do
		if child:IsA("ScreenGui") and not ownGuis[child] and child.Enabled then
			hiddenGuis[child] = true
			child.Enabled = false
		end
	end
	gameGuiConn = playerGui.ChildAdded:Connect(function(child)
		if child:IsA("ScreenGui") and not ownGuis[child] then
			task.defer(function()
				if child.Parent and child.Enabled then
					hiddenGuis[child] = true
					child.Enabled = false
				end
			end)
		end
	end)

	for _, coreType in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if coreType ~= Enum.CoreGuiType.All then
			local ok, enabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, coreType)
			if ok and enabled then
				hiddenCore[coreType] = true
				pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreType, false)
			end
		end
	end

	local ok, topbar = pcall(StarterGui.GetCore, StarterGui, "TopbarEnabled")
	if ok and topbar ~= false then
		hiddenTopbar = true
		pcall(StarterGui.SetCore, StarterGui, "TopbarEnabled", false)
	end
end

local function restoreGameUI()
	if gameGuiConn then
		gameGuiConn:Disconnect()
		gameGuiConn = nil
	end
	for g in pairs(hiddenGuis) do
		if g.Parent then
			g.Enabled = true
		end
	end
	table.clear(hiddenGuis)
	for coreType in pairs(hiddenCore) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreType, true)
	end
	table.clear(hiddenCore)
	if hiddenTopbar then
		hiddenTopbar = false
		pcall(StarterGui.SetCore, StarterGui, "TopbarEnabled", true)
	end
end

function setUIHidden(hidden, silent)
	if hidden == state.uiHidden then
		return
	end
	if hidden and not state.active then
		return
	end
	state.uiHidden = hidden
	if hidden then
		hideToast(true)
		if CONFIG.HideGameUI then
			hideGameUI()
		end
	else
		if CONFIG.HideGameUI then
			restoreGameUI()
		end
	end
	refreshVisibility()
	if hidden and not silent then
		local hint
		if hasKeyboard then
			hint = "press " .. KEYS.HideUI.Name .. " to show it again"
		elseif isTouch then
			hint = "tap the bottom-left corner to show it again"
		else
			hint = "press Y to show it again"
		end
		toast("UI hidden  -  " .. hint, true)
	end
end

--------------------------------------------------------------------------------
-- CHARACTER HIDING (local only)
--------------------------------------------------------------------------------
local decalOk = pcall(function()
	return Instance.new("Decal").LocalTransparencyModifier
end)

local charParts = {}
local charConn
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isTrackable(inst)
	return inst:IsA("BasePart") or (decalOk and inst:IsA("Decal"))
end

local function trackCharacter(char)
	table.clear(charParts)
	if charConn then
		charConn:Disconnect()
		charConn = nil
	end
	if not char then
		rayParams.FilterDescendantsInstances = {}
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if isTrackable(d) then
			table.insert(charParts, d)
		end
	end
	charConn = char.DescendantAdded:Connect(function(d)
		if isTrackable(d) then
			table.insert(charParts, d)
		end
	end)
	rayParams.FilterDescendantsInstances = { char }
end

local function setCharacterTransparency(value)
	for i = #charParts, 1, -1 do
		local p = charParts[i]
		if p.Parent then
			p.LocalTransparencyModifier = value
		else
			table.remove(charParts, i)
		end
	end
end

function setHideCharacter(enabled)
	state.hideCharacter = enabled
	toggles.hideChar:Set(enabled)
	if not enabled then
