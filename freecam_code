		render()
		onChange(value)
	end)

	render()
	return toggle
end

local function makeCycle(label, options, onChange)
	local row = new("Frame", {
		Name = label,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
		Parent = body,
	})
	new("TextLabel", {
		Size = UDim2.new(0.4, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		Font = THEME.Font,
		TextSize = 13,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(124, 28),
		BackgroundColor3 = THEME.Surface,
		AutoButtonColor = false,
		Text = "",
		Font = THEME.Font,
		TextSize = 13,
		TextColor3 = THEME.Text,
		Parent = row,
	}, { corner(8) })
	hover(btn)

	local index = 1
	local obj = {}
	function obj:Set(i)
		index = i
		btn.Text = options[i]
	end
	btn.Activated:Connect(function()
		index = index % #options + 1
		btn.Text = options[index]
		onChange(index)
	end)
	obj:Set(1)
	return obj
end

local function makeButtonRow(buttons)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
