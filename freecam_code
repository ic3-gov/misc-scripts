local toastVisible = false
local toastExpire = 0

function hideToast(instant)
	toastVisible = false
	if instant then
		activeTweens[toastFrame] = nil
		activeTweens[toastLabel] = nil
		activeTweens[toastStroke] = nil
		toastFrame.BackgroundTransparency = 1
		toastLabel.TextTransparency = 1
		toastStroke.Transparency = 1
	else
		tween(toastFrame, 0.25, { BackgroundTransparency = 1 })
		tween(toastLabel, 0.25, { TextTransparency = 1 })
		tween(toastStroke, 0.25, { Transparency = 1 })
	end
end

function toast(text, force)
	if state.uiHidden and not force then
		return
	end
	toastLabel.Text = text
	toastExpire = os.clock() + 1.6
	if not toastVisible then
		toastVisible = true
		tween(toastFrame, 0.18, { BackgroundTransparency = 0.12 })
		tween(toastLabel, 0.18, { TextTransparency = 0 })
		tween(toastStroke, 0.18, { Transparency = 0.35 })
	end
end

RunService.Heartbeat:Connect(function()
	if toastVisible and os.clock() > toastExpire then
		hideToast(false)
	end
end)

